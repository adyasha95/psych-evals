# =============================================================
# psych-evals environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================

# ------------------------------------------------------------------
# TARGET SYSTEM CONFIGURATION
# The system you want to evaluate. Choose one of the modes below.
# ------------------------------------------------------------------

# Mode 1: Point at a custom HTTP endpoint (any deployed model API)
# TARGET_ENDPOINT=https://your-api.example.com/v1/chat
# TARGET_ENDPOINT_API_KEY=your-bearer-token-here

# Mode 2: Evaluate an OpenAI model directly
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Mode 3: Evaluate an Anthropic model directly
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------
# JUDGE MODEL CONFIGURATION
# The model used internally to score responses (LLM-as-judge).
# Defaults to OpenAI GPT-4o if not set.
# Must be a different, trusted model from the one being evaluated.
# ------------------------------------------------------------------
JUDGE_PROVIDER=openai
JUDGE_API_KEY=sk-...
JUDGE_MODEL=gpt-4o

# ------------------------------------------------------------------
# OPTIONAL SETTINGS
# ------------------------------------------------------------------

# Maximum seconds to wait for a response from the target system
# TARGET_TIMEOUT=30

# How many test cases to run in parallel (default: 1 for safety)
# CONCURRENCY=1

# Output directory for results (default: ./results)
# RESULTS_DIR=./results
